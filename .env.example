# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Real environment variables take precedence over values in .env.

# --- LLM provider for eval/run_ragas.py (answer + score stages) ---
# If OPENROUTER_API_KEY is set, OpenRouter is used; otherwise the Anthropic API.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Models (optional; defaults shown, prices $/1M in/out, checked 2026-11-22) ---
# OpenRouter defaults: cheapest paid models. A default 50-question run is ~265 requests, ~$0.17.
GENERATOR_MODEL=anthropic/claude-haiku-5.5   # $0.10 / $0.50, cheapest Claude
JUDGE_MODEL=deepseek/deepseek-v4-flash       # $0.09 / $0.18, other vendor = no self-preference
# Anthropic API defaults (used when OPENROUTER_API_KEY is empty; Claude only):
#   GENERATOR_MODEL=claude-haiku-5-5
#   JUDGE_MODEL=claude-haiku-5-5
#
# Other options:
#   JUDGE_MODEL=z-ai/glm-5.3-flash               # $0.04 / $0.078, cheapest with structured outputs
#   JUDGE_MODEL=anthropic/claude-sonnet-5.5      # $2 / $10, strictest judge for a final run
#   GENERATOR_MODEL=anthropic/claude-opus-5.5    # $4 / $20, certifies the production LLM (design.md §0)
# Free models: 20 requests/min; 50 requests/day, or 1,000/day once $10 of credits were ever purchased.
# Free providers may log prompts; the vault is sent with every call.
#   GENERATOR_MODEL=google/gemma-4-31b-it:free
#   JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Concurrent LLM requests. Defaults to 1 when a :free model is set, otherwise 8.
# RAGAS_WORKERS=1

# --- Retrieval (mcp_servers/rag_server.py, see design.md ADR-006) ---
# RAG_RERANK_REPO=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANK_FILE=onnx/model.onnx
# RAG_RERANK_POOL=16
# Design-spec fallback reranker:
#   RAG_RERANK_REPO=onnx-community/bge-reranker-v2-m3-ONNX
#   RAG_RERANK_FILE=onnx/model_int8.onnx

# Optional: Hugging Face token for higher download rate limits.
# HF_TOKEN=
